# DashScope / Qwen
DASHSCOPE_API_KEY=your-dashscope-api-key
MODEL_NAME=qwen3-max
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=english_teaching_assistant

# Paths
UPLOAD_DIR=./uploads
TEMPLATE_DIR=./templates
LOG_DIR=./logs
OUTPUT_DIR=./output

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=textbook_chunks

# Local models
EMBEDDING_MODEL=./models/bge-m3
RERANKER_MODEL=./models/bge-reranker-large

# PaddleOCR
OCR_DET_MODEL_DIR=D:/paddleocr_models/det/ch/ch_PP-OCRv4_det_infer
OCR_REC_MODEL_DIR=D:/paddleocr_models/rec/ch/ch_PP-OCRv4_rec_infer
OCR_CLS_MODEL_DIR=D:/paddleocr_models/cls/ch_ppocr_mobile_v2.0_cls_infer
